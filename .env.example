# Скопируй в .env (cp .env.example .env) и поменяй значения. Файл .env в git не попадает.
# Значения ниже — учебные, не используй их нигде, кроме своего компьютера.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Контейнер db создаёт базу и пользователя по этим трём переменным
POSTGRES_DB=jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=change-me-db-password

# Django подключается к базе по этим переменным (значения должны совпадать с POSTGRES_*).
# DB_HOST и DB_PORT здесь — для запуска без Docker; в Compose сервис web
# подставляет DB_HOST=db и DB_PORT=5432 сам.
DB_NAME=jobtracker
DB_USER=jobtracker
DB_PASSWORD=change-me-db-password
DB_HOST=localhost
DB_PORT=5432# Скопируй в .env (cp .env.example .env) и поменяй значения. Файл .env в git не попадает.
